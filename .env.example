# Supabase do Pasto Leve (chave de serviço: só no servidor do worker, nunca no app)
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Modelo e segmentador (caminhos dentro do container)
BO_MODEL=models/phone_v0_bai.joblib
BO_SEG_WEIGHTS=yolov8n-seg.pt

# Loop do worker
BO_POLL_SECONDS=30
BO_ONCE=false
BO_LOG_LEVEL=INFO
